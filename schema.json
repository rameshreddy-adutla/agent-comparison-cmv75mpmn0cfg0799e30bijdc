{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Quote batch v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["quotes", "errors"],
  "properties": {
    "quotes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "sku", "partner", "currency", "price_id", "on_date", "quantity", "unit_price", "total_price"],
        "properties": {
          "request_id": {"type": "string"},
          "sku": {"type": "string"},
          "partner": {"type": "string"},
          "currency": {"type": "string"},
          "price_id": {"type": "string"},
          "on_date": {"type": "string"},
          "quantity": {"type": "integer", "minimum": 1, "maximum": 1000000},
          "unit_price": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$"},
          "total_price": {"type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$"}
        }
      }
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "code"],
        "properties": {
          "request_id": {"type": ["string", "null"]},
          "code": {"enum": ["INVALID_REQUEST", "NO_PRICE", "AMBIGUOUS_PRICE"]}
        }
      }
    }
  }
}
